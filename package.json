{
  "name": "farthest-outpost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/content packages/sim packages/skins packages/bots packages/rater packages/sequencer packages/generator packages/render-2d packages/render-3d packages/client",
    "check": "pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @fo/client dev",
    "build": "pnpm --filter @fo/client build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "fast-check": "^4.1.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
