{
  "name": "farthest-outpost",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/content packages/sim packages/skins packages/bots packages/rater packages/sequencer packages/generator packages/render-2d packages/render-3d packages/client tools",
    "check": "pnpm typecheck && pnpm test",
    "dev": "pnpm --filter @fo/client dev",
    "build": "pnpm --filter @fo/client build && node -e \"require('fs').rmSync('dist',{recursive:true,force:true});require('fs').cpSync('packages/client/dist','dist',{recursive:true})\"",
    "levels:build": "vite-node tools/build-levels.ts --",
    "levels:check": "vite-node tools/regress-levels.ts --",
    "levels:next": "vite-node tools/levels-next.ts --",
    "models:build": "vite-node tools/build-models.ts --"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.170.0",
    "fast-check": "^4.1.1",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "three": "^0.170.0",
    "three-mesh-bvh": "^0.9.16",
    "typescript": "^5.8.3",
    "vite-node": "3.2.4",
    "vitest": "^3.2.4",
    "watlas": "^1.0.1"
  },
  "engines": {
    "node": "24.x"
  }
}
